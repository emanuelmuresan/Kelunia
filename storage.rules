// Regulile Firebase Storage: în prezent aplicația nu stochează fișiere, așa că ORICE citire sau scriere este refuzată (ultima regulă).
// Funcțiile de mai jos (autentificare, proprietar, manager, acces la locație) sunt pregătite pentru o eventuală folosire a Storage și sunt neutilizate acum.
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Utilizator autentificat, cu emailul verificat.
    function signedIn() {
      return request.auth != null;
    }

    function emailVerified() {
      return signedIn()
        && request.auth.token.email_verified == true;
    }

    function signedInVerified() {
      return emailVerified();
    }

    // Documentul utilizatorului din Firestore, de unde se citesc rolul și locația.
    function userPath() {
      return /databases/(default)/documents/users/$(request.auth.uid);
    }

    function hasUserDoc() {
      return signedIn()
        && firestore.exists(userPath());
    }

    function userData() {
      return firestore.get(userPath()).data;
    }

    // Proprietarul platformei: emailul fix al proprietarului sau câmpul isOwner din profil.
    function isOwner() {
      return signedInVerified()
        && (
          request.auth.token.email == "emanuelmuresan@gmail.com"
          || (
            hasUserDoc()
            && userData().isOwner == true
          )
        );
    }

    // Managerul unei locații (nu proprietarul).
    function isManager() {
      return signedInVerified()
        && hasUserDoc()
        && userData().isOwner != true
        && (
          userData().role == "manager"
          || userData().role == "superadmin"
        );
    }

    // Cine poate citi sau scrie fișiere ale unei locații.
    function canReadLocation(locationId) {
      return isOwner()
        || (
          hasUserDoc()
          && userData().locationId == locationId
        );
    }

    function canWriteLocation(locationId) {
      return isOwner()
        || (
          isManager()
          && userData().locationId == locationId
        );
    }

    // Regula de siguranță: tot ce nu este permis explicit este refuzat.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
