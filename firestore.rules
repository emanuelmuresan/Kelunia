// Regulile Firestore ale Kelunia: ce are voie să citească și să scrie fiecare utilizator din client. Funcțiile cloud folosesc Admin SDK și ocolesc aceste reguli,
// deci regulile de aici și verificările din functions/src/index.ts trebuie păstrate în acord.
// Autorizarea se bazează pe documentul users/{uid} (rol, locație), nu pe claim-uri; orice scriere cere email verificat, cu excepțiile marcate mai jos.
// Fișierul are trei părți: ajutoare de identitate și rol, validatoare pentru forma documentelor și, la final, regulile fiecărei colecții.
// Atenție: Firestore limitează evaluarea unei reguli la 1000 de expresii; de aceea unele funcții sunt scrise compact (vezi comentariile despre buget).
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Identitate: utilizator autentificat, cu emailul verificat, și proprietarul platformei (emailul fix).
    function signedIn() {
      return request.auth != null;
    }

    function emailVerified() {
      return signedIn()
        && request.auth.token.email_verified == true;
    }

    function signedInVerified() {
      return emailVerified();
    }

    function isOwnerEmail() {
      return signedInVerified()
        && request.auth.token.email == "emanuelmuresan@gmail.com";
    }

    // Profilul utilizatorului curent, citit din users/{uid}, și locația lui.
    function hasUserDoc() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userLocationId() {
      return hasUserDoc() ? userData().locationId : "";
    }

    // Proprietarul platformei: emailul fix sau câmpul isOwner din profil.
    function isOwner() {
      return isOwnerEmail()
        || (
          hasUserDoc()
          && userData().isOwner == true
        );
    }

    // Rolurile; acceptă și numele vechi (superadmin, admin, collaborator, viewer, user) pentru compatibilitate.
    function isManagerRole(role) {
      return role == "manager"
        || role == "superadmin"
        || role == "administrator"
        || role == "admin";
    }

    function isMemberRole(role) {
      return role == "member"
        || role == "collaborator"
        || role == "colaborator";
    }

    function isGuestRole(role) {
      return role == "guest" || role == "viewer" || role == "user";
    }

    // Limbile acceptate pentru interfață.
    function validLanguage(value) {
      return value == "ro"
        || value == "en"
        || value == "es"
        || value == "it"
        || value == "fr"
        || value == "pt";
    }

    // Managerul locației (nu proprietarul) și administratorul larg (manager sau membru).
    function isLocationSuperAdmin() {
      return signedInVerified()
        && hasUserDoc()
        && isManagerRole(userData().role)
        && userData().isOwner != true;
    }

    function isLocationAdmin() {
      return signedInVerified()
        && hasUserDoc()
        && userData().isOwner != true
        && (
          isMemberRole(userData().role)
          || isManagerRole(userData().role)
        );
    }

    // Un manager poate gestiona doar propria locație.
    function canManageLocation(locationId) {
      return isLocationSuperAdmin()
        && locationId == userLocationId();
    }

    // Starea de scriere a locației: scrierea e permisă proprietarului sau dacă facturarea este activă ori în probă neexpirată.
    function locationPath(locationId) {
      return /databases/$(database)/documents/locations/$(locationId);
    }

    function locationWriteEnabled(locationId) {
      return isOwner()
        || (
          exists(locationPath(locationId))
          && (
            !hasKey(get(locationPath(locationId)).data, "billingStatus")
            || get(locationPath(locationId)).data.billingStatus == "active"
            || (
              get(locationPath(locationId)).data.billingStatus == "trialing"
              && (
                !hasKey(get(locationPath(locationId)).data, "trialEndsAt")
                || get(locationPath(locationId)).data.trialEndsAt == null
                || get(locationPath(locationId)).data.trialEndsAt > request.time
              )
            )
          )
        );
    }

    function hasKey(data, key) {
      // `key in data` is a native presence check; `data.keys().hasAny([key])`
      // re-materialises the key list every call and, across the ~30 hasKey calls
      // in validUserDataShape, was a big part of the 1000-expression blowup.
      return key in data;
    }

    // Validatoare generice pentru câmpuri: text, culoare, bool, timestamp, liste.
    function validText(value, maxSize) {
      return value is string
        && value.size() > 0
        && value.size() <= maxSize;
    }

    function validTextOrEmpty(value, maxSize) {
      return value is string
        && value.size() <= maxSize;
    }

    function validOptionalText(data, key, maxSize) {
      return !hasKey(data, key)
        || validTextOrEmpty(data[key], maxSize);
    }

    function validOptionalColor(data, key) {
      return !hasKey(data, key)
        || (
          data[key] is string
          && data[key].matches("^#[0-9a-fA-F]{6}$")
        );
    }

    function validOptionalBool(data, key) {
      return !hasKey(data, key)
        || data[key] is bool;
    }

    function validOptionalTimestamp(data, key) {
      return !hasKey(data, key)
        || data[key] is timestamp;
    }

    // Validatoare pentru momentele de notificare.
    // Shape checks for the two notification-offset list formats. Per-element (max
    // 5 items) instead of the previous ~230-entry hasOnly([...]) list, which —
    // evaluated several times per users/{uid} write — blew past Firestore's
    // 1000-expression limit. Exact ranges stay enforced by the client / Cloud
    // Functions; here we only reject non-strings / non-ints and the wrong shape.
    function validOffsetRuleItem(v) {
      return v is string && v.matches("^[1-9][0-9]{0,2}(m|h|d)$");
    }

    function validOffsetDayItem(v) {
      return v is int && v >= 1 && v <= 30;
    }

    function validOptionalNotificationOffsets(data, key) {
      return !(key in data)
        || (
          data[key] is list
          && data[key].size() <= 5
          && (data[key].size() < 1 || validOffsetDayItem(data[key][0]))
          && (data[key].size() < 2 || validOffsetDayItem(data[key][1]))
          && (data[key].size() < 3 || validOffsetDayItem(data[key][2]))
          && (data[key].size() < 4 || validOffsetDayItem(data[key][3]))
          && (data[key].size() < 5 || validOffsetDayItem(data[key][4]))
        );
    }

    function validOptionalNotificationOffsetRules(data, key) {
      return !(key in data)
        || (
          data[key] is list
          && data[key].size() <= 5
          && (data[key].size() < 1 || validOffsetRuleItem(data[key][0]))
          && (data[key].size() < 2 || validOffsetRuleItem(data[key][1]))
          && (data[key].size() < 3 || validOffsetRuleItem(data[key][2]))
          && (data[key].size() < 4 || validOffsetRuleItem(data[key][3]))
          && (data[key].size() < 5 || validOffsetRuleItem(data[key][4]))
        );
    }

    // Ștergerea logică (deleted, deletedAt...), valori nule, contoare și limite de plan.
    function validSoftDeleteFields(data) {
      return validOptionalBool(data, "deleted")
        && (!hasKey(data, "deletedAt") || validNullableTimestamp(data.deletedAt))
        && validOptionalText(data, "deletedBy", 180)
        && validOptionalText(data, "deletedByUid", 160);
    }

    function validNullableTimestamp(value) {
      return value == null
        || value is timestamp;
    }

    function validCounterValue(value) {
      return value is int
        && value >= 0;
    }

    function validNullableLimit(value) {
      return value == null
        || (
          value is int
          && value >= 0
        );
    }

    // Planurile și starea de facturare ale unei locații, contoarele de utilizare și limitele planului.
    function validLocationPlan(value) {
      return value == "trial"
        || value == "standard"
        || value == "pro"
        || value == "Pro"
        || value == "PRO"
        || value == "business"
        || value == "Business"
        || value == "BUSINESS"
        || value == "plus"
        || value == "enterprise";
    }

    function validBillingStatus(value) {
      return value == "trialing"
        || value == "active"
        || value == "past_due"
        || value == "paused"
        || value == "canceled"
        || value == "expired";
    }

    function validUsageCounters(usage) {
      return usage is map
        && usage.keys().hasOnly([
          "bookingCount",
          "roomCount",
          "groupCount",
          "fixedScheduleCount",
          "accessCodeCount",
          "memberCount"
        ])
        && (!hasKey(usage, "bookingCount") || validCounterValue(usage.bookingCount))
        && (!hasKey(usage, "roomCount") || validCounterValue(usage.roomCount))
        && (!hasKey(usage, "groupCount") || validCounterValue(usage.groupCount))
        && (!hasKey(usage, "fixedScheduleCount") || validCounterValue(usage.fixedScheduleCount))
        && (!hasKey(usage, "accessCodeCount") || validCounterValue(usage.accessCodeCount))
        && (!hasKey(usage, "memberCount") || validCounterValue(usage.memberCount));
    }

    function validPlanLimits(limits) {
      return limits is map
        && limits.keys().hasOnly([
          "maxMembers",
          "maxManagers",
          "maxRooms",
          "maxGroups",
          "maxActiveBookings"
        ])
        && (!hasKey(limits, "maxMembers") || validNullableLimit(limits.maxMembers))
        && (!hasKey(limits, "maxManagers") || (limits.maxManagers is int && limits.maxManagers >= 0))
        && (!hasKey(limits, "maxRooms") || validNullableLimit(limits.maxRooms))
        && (!hasKey(limits, "maxGroups") || validNullableLimit(limits.maxGroups))
        && (!hasKey(limits, "maxActiveBookings") || validNullableLimit(limits.maxActiveBookings));
    }

    // Formatul datei (AAAA-LL-ZZ) și al orei (OO:MM).
    function validDateKey(value) {
      return value is string
        && value.size() == 10;
    }

    function validTime(value) {
      return value is string
        && value.size() == 5;
    }

    // Codurile de acces: rol, grup, număr maxim de utilizări (manager 1, membru 10, oaspete nelimitat) și accesul la camere.
    function validAccessRole(role) {
      return isGuestRole(role)
        || isMemberRole(role)
        || isManagerRole(role);
    }

    function validAccessGroup(role, groupName) {
      return (
          isManagerRole(role)
          && groupName == ""
        )
        || (
          !isManagerRole(role)
          && validText(groupName, 120)
        );
    }

    function validAccessUsage(role, maxUses, usedCount, active) {
      return active is bool
        && usedCount is int
        && usedCount >= 0
        && (
          (
            isManagerRole(role)
            && maxUses is int
            && maxUses == 1
          )
          || (
            isMemberRole(role)
            && maxUses is int
            && maxUses == 10
          )
          || (
            isGuestRole(role)
            && maxUses == null
          )
        );
    }

    function validRoomAccessData(role, data) {
      return (
          !hasKey(data, "roomAccess")
          && !hasKey(data, "allowedRoomIds")
        )
        || (
          data.roomAccess == "all"
          && data.allowedRoomIds is list
          && data.allowedRoomIds.size() == 0
        )
        || (
          !isManagerRole(role)
          && data.roomAccess == "selected"
          && data.allowedRoomIds is list
          && data.allowedRoomIds.size() > 0
          && data.allowedRoomIds.size() <= 100
        );
    }

    // Accesul la camere și la grup pentru rezervări: managerii și proprietarul oricare, membrii doar grupul lor și camerele permise.
    function roomAccessAllows(roomId) {
      return isOwner()
        || isLocationSuperAdmin()
        || !hasKey(userData(), "roomAccess")
        || userData().roomAccess == "all"
        || (
          roomId is string
          && roomId.size() > 0
          && userData().allowedRoomIds is list
          && userData().allowedRoomIds.hasAny([roomId])
        );
    }

    function bookingGroupAllowed(data) {
      return isOwner()
        || isLocationSuperAdmin()
        || (
          isMemberRole(userData().role)
          && hasKey(userData(), "groupName")
          && userData().groupName == data.group
        );
    }

    // Căi către documentele codurilor de acces și ale licențelor.
    function accessCodePath(codeId) {
      return /databases/$(database)/documents/accessCodes/$(codeId);
    }

    function licensePath(licenseId) {
      return /databases/$(database)/documents/licenses/$(licenseId);
    }

    // Câte utilizări are un cod deja.
    function existingCodeUsedCount(codeId) {
      return get(accessCodePath(codeId)).data.usedCount is int
        ? get(accessCodePath(codeId)).data.usedCount
        : 0;
    }

    // Codes without an expiresAt (every one created before this field existed)
    // are grandfathered as non-expiring - only a code that explicitly carries a
    // past expiresAt is rejected.
    function accessCodeNotExpired(code) {
      return !("expiresAt" in code) || request.time < code.expiresAt;
    }

    // Folosirea unui cod la înregistrare: crește usedCount cu 1, doar dacă e activ, neexpirat și cu utilizări rămase; nu se pot schimba rolul, grupul sau locația.
    function validAccessUseUpdate(codeId) {
      return signedIn()
        && exists(accessCodePath(codeId))
        && resource.data.code == codeId
        && resource.data.active != false
        && accessCodeNotExpired(resource.data)
        && request.resource.data.role == resource.data.role
        && request.resource.data.groupName == resource.data.groupName
        && request.resource.data.locationId == resource.data.locationId
        && request.resource.data.locationName == resource.data.locationName
        && request.resource.data.code == resource.data.code
        && validAccessUsage(
          resource.data.role,
          request.resource.data.maxUses,
          request.resource.data.usedCount,
          request.resource.data.active
        )
        && request.resource.data.usedCount == existingCodeUsedCount(codeId) + 1
        && (
          request.resource.data.maxUses == null
          || existingCodeUsedCount(codeId) < request.resource.data.maxUses
        )
        && request.resource.data.lastUsedByUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "active",
          "maxUses",
          "usedCount",
          "lastUsedAt",
          "lastUsedBy",
          "lastUsedByUid"
        ]);
    }

    // Ștergerea logică a unui cod de acces.
    function canSoftDeleteAccessCode() {
      return isOwner()
        ? true
        : (
          isLocationSuperAdmin()
          && hasKey(resource.data, "locationId")
          && resource.data.locationId is string
          && resource.data.locationId == userLocationId()
          && locationWriteEnabled(resource.data.locationId)
        );
    }

    function validAccessCodeSoftDeleteUpdate() {
      return signedInVerified()
        && canSoftDeleteAccessCode()
        && (
          !hasKey(resource.data, "locationId")
          || request.resource.data.locationId == resource.data.locationId
        )
        && (
          !hasKey(resource.data, "code")
          || request.resource.data.code == resource.data.code
        )
        && (
          (
            request.resource.data.active == false
            && request.resource.data.deleted == true
          )
          // Undo of a soft delete, folded into this branch: a separate branch
          // pushed the manager-edit path past the 1000-expression budget.
          || (
            resource.data.get("deleted", false) == true
            && request.resource.data.deleted == false
            && request.resource.data.active is bool
            && validAccessUsage(
              resource.data.role,
              resource.data.maxUses,
              resource.data.usedCount,
              request.resource.data.active
            )
          )
        )
        && validSoftDeleteFields(request.resource.data)
        && validOptionalText(request.resource.data, "updatedBy", 180)
        && validOptionalTimestamp(request.resource.data, "updatedAt")
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "active",
          "deleted",
          "deletedAt",
          "deletedBy",
          "deletedByUid",
          "updatedBy",
          "updatedAt"
        ]);
    }

    // Aliasing request/resource data keeps this write inside Firestore's
    // 1000-expression budget (it used to sit at the very edge).
    function validAccessCodeManagerUpdate() {
      let before = resource.data;
      let after = request.resource.data;
      return (
          isOwner()
          || (
            isLocationSuperAdmin()
            && before.locationId == userLocationId()
          )
        )
        && locationWriteEnabled(before.locationId)
        && after.locationId == before.locationId
        && after.code == before.code
        && validText(after.locationName, 180)
        && validAccessRole(after.role)
        && validAccessGroup(after.role, after.groupName)
        && validRoomAccessData(after.role, after)
        && validAccessUsage(after.role, after.maxUses, after.usedCount, after.active)
        && validSoftDeleteFields(after)
        && (!("expiresAt" in after) || after.expiresAt is timestamp)
        && after.diff(before).affectedKeys().hasOnly([
          "role",
          "groupName",
          "roomAccess",
          "allowedRoomIds",
          "locationName",
          "maxUses",
          "usedCount",
          "active",
          "updatedBy",
          "updatedAt",
          "deleted",
          "deletedAt",
          "deletedBy",
          "deletedByUid",
          "expiresAt"
        ]);
    }

    // Un utilizator nou își creează profilul pe baza unui cod de acces, de licență sau în cont de probă (valorile trebuie să coincidă cu ale codului).
    function validAccessCodeForUserCreate(data, userId) {
      let codeId = data.accessCodeId;
      let code = get(accessCodePath(codeId)).data;
      let after = getAfter(accessCodePath(codeId)).data;
      return codeId is string
        && codeId.size() > 0
        && exists(accessCodePath(codeId))
        && code.active != false
        && accessCodeNotExpired(code)
        && data.role == code.role
        && data.accessCodeRole == code.role
        && data.locationId == code.locationId
        && data.locationName == code.locationName
        && data.groupName == code.groupName
        && data.group == code.groupName
        && validAccessGroup(code.role, code.groupName)
        && (
          (
            !hasKey(code, "roomAccess")
            && data.roomAccess == "all"
            && data.allowedRoomIds is list
            && data.allowedRoomIds.size() == 0
          )
          || (
            data.roomAccess == code.roomAccess
            && data.allowedRoomIds == code.allowedRoomIds
            && validRoomAccessData(code.role, data)
          )
        )
        && validAccessUsage(code.role, after.maxUses, after.usedCount, after.active)
        && after.usedCount == existingCodeUsedCount(codeId) + 1
        && (
          after.maxUses == null
          || existingCodeUsedCount(codeId) < after.maxUses
        )
        && after.lastUsedByUid == userId;
    }

    // Profilul creat cu licență și cu cont de probă.
    function validLicenseForUserCreate(data, userId) {
      let licenseId = data.pendingLicenseId;
      let license = get(licensePath(licenseId)).data;
      let after = getAfter(licensePath(licenseId)).data;
      return licenseId is string
        && licenseId.size() > 0
        && exists(licensePath(licenseId))
        && license.used != true
        && license.claimed != true
        && license.active != false
        && license.deleted != true
        && after.claimed == true
        && after.claimedByUid == userId;
    }

    function validTrialUserCreate(data) {
      return data.isOwner == false
        && data.locationSetupRequired == true
        && isManagerRole(data.role)
        && data.locationId == ""
        && data.locationName == ""
        && data.groupName == ""
        && data.group == ""
        && data.pendingLicenseId == ""
        && data.pendingLicenseCode == ""
        && data.roomAccess == "all"
        && data.allowedRoomIds is list
        && data.allowedRoomIds.size() == 0
        && (!hasKey(data, "accessCodeId") || data.accessCodeId == "");
    }

    // Un manager nou fără locație încă (cont de probă sau licență) își poate configura locația.
    function hasPendingLocationSetup() {
      return hasUserDoc()
        && isManagerRole(userData().role)
        && userData().isOwner != true
        && userData().locationSetupRequired == true
        && userData().locationId == "";
    }

    function hasPendingLicense() {
      return hasPendingLocationSetup()
        && userData().pendingLicenseId is string
        && userData().pendingLicenseId != "";
    }

    function hasPendingTrialSetup() {
      return hasPendingLocationSetup()
        && (
          !hasKey(userData(), "pendingLicenseId")
          || userData().pendingLicenseId == ""
        );
    }

    // Inlined (no per-field helper calls) and using `key in data` — the previous
    // ~30 helper invocations, each re-materialising data.keys(), pushed writes past
    // Firestore's 1000-expression limit on the users/{uid} update path.
    // Forma documentului users/{uid}: câmpuri permise, tipuri și valori.
    function validUserRole(value) {
      return value in [
        "manager", "superadmin", "administrator", "admin",
        "member", "collaborator", "colaborator",
        "guest", "viewer", "user"
      ];
    }

    function validUserDataShape(data) {
      return data.keys().hasOnly([
          "uid",
          "email",
          "displayName",
          "groupName",
          "group",
          "role",
          "isOwner",
          "locationId",
          "locationName",
          "accessCodeId",
          "accessCodeRole",
          "roomAccess",
          "allowedRoomIds",
          "pendingLicenseId",
          "pendingLicenseCode",
          "locationSetupRequired",
          "usePin",
          "pinHash",
          "pinSet",
          "pinResetRequired",
          "lockOnHide",
          "useBiometrics",
          "language",
          "notifyGroupBookings",
          "notifyFixedGroupSchedules",
          "notifyWeekBefore",
          "notifyDayBefore",
          "notifyOffsets",
          "notifyOffsetsDays",
          "verificationEmailSentAt",
          "createdAt"
        ])
        && (!("uid" in data) || (data.uid is string && data.uid.size() <= 160))
        && (!("email" in data) || (data.email is string && data.email.size() <= 180))
        && (!("displayName" in data) || (data.displayName is string && data.displayName.size() <= 120))
        && (!("groupName" in data) || (data.groupName is string && data.groupName.size() <= 120))
        && (!("group" in data) || (data.group is string && data.group.size() <= 120))
        && (!("role" in data) || validUserRole(data.role))
        && (!("isOwner" in data) || data.isOwner is bool)
        && (!("locationId" in data) || (data.locationId is string && data.locationId.size() <= 160))
        && (!("locationName" in data) || (data.locationName is string && data.locationName.size() <= 180))
        && (!("accessCodeId" in data) || (data.accessCodeId is string && data.accessCodeId.size() <= 80))
        && (!("accessCodeRole" in data) || validUserRole(data.accessCodeRole))
        && (!("roomAccess" in data) || data.roomAccess in ["all", "selected"])
        && (!("allowedRoomIds" in data) || (data.allowedRoomIds is list && data.allowedRoomIds.size() <= 100))
        && (!("pendingLicenseId" in data) || (data.pendingLicenseId is string && data.pendingLicenseId.size() <= 120))
        && (!("pendingLicenseCode" in data) || (data.pendingLicenseCode is string && data.pendingLicenseCode.size() <= 120))
        && (!("locationSetupRequired" in data) || data.locationSetupRequired is bool)
        && (!("usePin" in data) || data.usePin is bool)
        && (!("pinHash" in data) || (data.pinHash is string && data.pinHash.size() <= 180))
        && (!("pinSet" in data) || data.pinSet is bool)
        && (!("pinResetRequired" in data) || data.pinResetRequired is bool)
        && (!("lockOnHide" in data) || data.lockOnHide is bool)
        && (!("useBiometrics" in data) || data.useBiometrics is bool)
        && (!("language" in data) || validLanguage(data.language))
        && (!("notifyGroupBookings" in data) || data.notifyGroupBookings is bool)
        && (!("notifyFixedGroupSchedules" in data) || data.notifyFixedGroupSchedules is bool)
        && (!("notifyWeekBefore" in data) || data.notifyWeekBefore is bool)
        && (!("notifyDayBefore" in data) || data.notifyDayBefore is bool)
        && (!("notifyOffsets" in data) || (data.notifyOffsets is list && data.notifyOffsets.size() <= 5))
        && (!("notifyOffsetsDays" in data) || (data.notifyOffsetsDays is list && data.notifyOffsetsDays.size() <= 5))
        && (!("verificationEmailSentAt" in data) || data.verificationEmailSentAt is timestamp)
        && (!("createdAt" in data) || data.createdAt is timestamp);
    }

    // Crearea profilului propriu: doar cu un cod de acces valid, licență sau ca cont de probă; niciodată ca proprietar.
    function validUserCreate(userId) {
      return signedIn()
        && request.auth.uid == userId
        && validUserDataShape(request.resource.data)
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.get("pinSet", false) == false
        && request.resource.data.get("pinResetRequired", false) == false
        && (
          (
            isOwnerEmail()
            && request.resource.data.isOwner == true
            && isManagerRole(request.resource.data.role)
            && request.resource.data.locationId == ""
            && request.resource.data.groupName == ""
            && request.resource.data.accessCodeId == ""
          )
          || (
            request.resource.data.isOwner == false
            && request.resource.data.locationSetupRequired == true
            && isManagerRole(request.resource.data.role)
            && request.resource.data.locationId == ""
            && request.resource.data.groupName == ""
            && (
              validTrialUserCreate(request.resource.data)
              || validLicenseForUserCreate(request.resource.data, userId)
            )
          )
          || (
            request.resource.data.isOwner == false
            // .get(..., false): access-code signups never used to write this
            // field at all (now fixed client-side to send false explicitly),
            // and a raw != comparison against a missing key hard-errors the
            // whole rule instead of just failing the condition - which is
            // exactly what broke every access-code registration before.
            && request.resource.data.get("locationSetupRequired", false) != true
            && validAccessCodeForUserCreate(request.resource.data, userId)
          )
        );
    }

    // Cele patru feluri de actualizare a unui profil: proprietarul platformei se sincronizează, utilizatorul își schimbă setările personale,
    // un manager nou își termină configurarea locației, iar un manager modifică alți utilizatori din locația lui.
    function validOwnerSyncUpdate(userId) {
      return signedInVerified()
        && isOwnerEmail()
        && request.auth.uid == userId
        && request.resource.data.role == "manager"
        && request.resource.data.isOwner == true;
    }

    // Setările personale pe care utilizatorul și le poate schimba singur (nume, grup, PIN activ, limbă, notificări); rolul, locația și câmpurile PIN rămân protejate.
    function validOwnUserSettingsShape(data) {
      return validOptionalText(data, "displayName", 120)
        && validOptionalText(data, "groupName", 120)
        && validOptionalText(data, "group", 120)
        && validOptionalBool(data, "usePin")
        && validOptionalText(data, "pinHash", 180)
        && validOptionalBool(data, "pinSet")
        && validOptionalBool(data, "lockOnHide")
        && validOptionalBool(data, "useBiometrics")
        && (!hasKey(data, "language") || validLanguage(data.language))
        && validOptionalBool(data, "notifyGroupBookings")
        && validOptionalBool(data, "notifyFixedGroupSchedules")
        && validOptionalBool(data, "notifyWeekBefore")
        && validOptionalBool(data, "notifyDayBefore")
        && validOptionalNotificationOffsetRules(data, "notifyOffsets")
        && validOptionalNotificationOffsets(data, "notifyOffsetsDays");
    }

    function validOwnUserUpdate(userId) {
      return signedInVerified()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "displayName",
          "groupName",
          "group",
          "usePin",
          "lockOnHide",
          "useBiometrics",
          "language",
          "notifyGroupBookings",
          "notifyFixedGroupSchedules",
          "notifyWeekBefore",
          "notifyDayBefore",
          "notifyOffsets",
          "notifyOffsetsDays"
        ])
        && validOwnUserSettingsShape(request.resource.data)
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(["groupName", "group"])
          || request.resource.data.groupName == request.resource.data.group
        );
    }

    // Actualizare de metadate proprie: rolul, proprietarul, locația și câmpurile PIN nu se pot schimba.
    function validOwnUserMetadataUpdate(userId) {
      // validUserDataShape(request.resource.data) is already asserted by the caller
      // (the users/{userId} allow-update rule) before this branch runs.
      return signedInVerified()
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.isOwner == resource.data.isOwner
        && request.resource.data.locationId == resource.data.locationId
        && request.resource.data.get("pinSet", false) == resource.data.get("pinSet", false)
        && request.resource.data.get("pinResetRequired", false) == resource.data.get("pinResetRequired", false)
        && (
          (
            !hasKey(resource.data, "roomAccess")
            && request.resource.data.roomAccess == "all"
          )
          || request.resource.data.roomAccess == resource.data.roomAccess
        )
        && (
          (
            !hasKey(resource.data, "allowedRoomIds")
            && request.resource.data.allowedRoomIds is list
            && request.resource.data.allowedRoomIds.size() == 0
          )
          || request.resource.data.allowedRoomIds == resource.data.allowedRoomIds
        );
    }

    // Finalizarea configurării locației de către un manager nou: scrie locația și închide „locationSetupRequired”.
    function validLocationSetupUserUpdate(userId) {
      return signedInVerified()
        && request.auth.uid == userId
        && isManagerRole(resource.data.role)
        && resource.data.isOwner != true
        && resource.data.locationSetupRequired == true
        && request.resource.data.role == resource.data.role
        && request.resource.data.isOwner == resource.data.isOwner
        && request.resource.data.locationSetupRequired == false
        && request.resource.data.locationId != ""
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "locationId",
          "locationName",
          "locationSetupRequired",
          "pendingLicenseId",
          "pendingLicenseCode"
        ]);
    }

    // Un manager modifică alți utilizatori din locația lui, fără să schimbe locația, proprietarul sau câmpurile PIN.
    function validManagerUserUpdate(userId) {
      // validUserDataShape(request.resource.data) is already asserted by the caller
      // (the users/{userId} allow-update rule) before this branch runs. This branch
      // is for managing OTHER users in the location — self-updates go through
      // validOwnUserUpdate / validOwnUserMetadataUpdate / validOwnerSyncUpdate.
      return request.auth.uid != userId
        && (isOwner() || isLocationSuperAdmin())
        && (
          isOwner()
          || resource.data.locationId == userLocationId()
        )
        && resource.data.isOwner != true
        && request.resource.data.locationId == resource.data.locationId
        && request.resource.data.isOwner == resource.data.isOwner
        && request.resource.data.get("pinSet", false) == resource.data.get("pinSet", false)
        && request.resource.data.get("pinResetRequired", false) == resource.data.get("pinResetRequired", false);
    }

    // Forma documentelor: rezervări, camere/grupuri și programe fixe.
    function validEventData(data) {
      return data.keys().hasOnly([
          "group",
          "congregatie",
          "room",
          "roomId",
          "location",
          "startDate",
          "endDate",
          "startTime",
          "endTime",
          "orar",
          "reason",
          "motiv",
          "authorEmail",
          "authorName",
          "updatedBy",
          "locationId",
          "locationName",
          "notifyOnThisBooking",
          "notifyOffsets",
          "notifyForUid",
          "notifyGroupOnThisBooking",
          "notifyGroupOffsets",
          "notifyGroupAudience",
          "notifyGroupRecipients",
          "notifyGroupNowAt",
          "notifyGroupNowBy",
          "updatedAt",
          "createdAt",
          "deleted",
          "deletedAt",
          "deletedBy",
          "deletedByUid"
        ])
        && validText(data.group, 120)
        && data.congregatie == data.group
        && validText(data.room, 120)
        && validOptionalText(data, "roomId", 160)
        && data.location == data.room
        && validDateKey(data.startDate)
        && validDateKey(data.endDate)
        && data.endDate >= data.startDate
        && validTime(data.startTime)
        && validTime(data.endTime)
        && validText(data.orar, 32)
        && validTextOrEmpty(data.reason, 300)
        && data.motiv == data.reason
        && validText(data.authorEmail, 180)
        && validText(data.authorName, 120)
        && validTextOrEmpty(data.updatedBy, 180)
        && validText(data.locationId, 160)
        && validTextOrEmpty(data.locationName, 180)
        && validOptionalBool(data, "notifyOnThisBooking")
        && validOptionalNotificationOffsetRules(data, "notifyOffsets")
        && validOptionalText(data, "notifyForUid", 160)
        && validOptionalBool(data, "notifyGroupOnThisBooking")
        && validOptionalNotificationOffsetRules(data, "notifyGroupOffsets")
        && (!hasKey(data, "notifyGroupAudience") || data.notifyGroupAudience in ["all", "selected"])
        && validOptionalStringList(data, "notifyGroupRecipients", 200)
        && validOptionalTimestamp(data, "notifyGroupNowAt")
        && validOptionalText(data, "notifyGroupNowBy", 180)
        && data.updatedAt is timestamp
        && validOptionalTimestamp(data, "createdAt")
        && validSoftDeleteFields(data);
    }

    function validSpaceData(data) {
      return data.keys().hasOnly([
          "name",
          "floorLabel",
          "color",
          "activeUntil",
          "locationId",
          "locationName",
          "createdBy",
          "createdAt",
          "updatedBy",
          "updatedAt",
          "deleted",
          "deletedAt",
          "deletedBy",
          "deletedByUid"
        ])
        && validText(data.name, 120)
        && validOptionalText(data, "floorLabel", 80)
        && validOptionalColor(data, "color")
        && (!("activeUntil" in data) || (data.activeUntil is string && data.activeUntil.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")))
        && validText(data.locationId, 160)
        && validTextOrEmpty(data.locationName, 180)
        && validOptionalText(data, "createdBy", 180)
        && validOptionalTimestamp(data, "createdAt")
        && validOptionalText(data, "updatedBy", 180)
        && validOptionalTimestamp(data, "updatedAt")
        && validSoftDeleteFields(data);
    }

    function validFixedScheduleData(data) {
      return data.keys().hasOnly([
          "dayIndex",
          "group",
          "room",
          "startTime",
          "endTime",
          "title",
          "locationId",
          "locationName",
          "createdAt",
          "updatedBy",
          "updatedAt",
          "deleted",
          "deletedAt",
          "deletedBy",
          "deletedByUid"
        ])
        && data.dayIndex is int
        && data.dayIndex >= 0
        && data.dayIndex <= 6
        && validText(data.group, 120)
        && validText(data.room, 120)
        && validTime(data.startTime)
        && validTime(data.endTime)
        && validText(data.title, 160)
        && validText(data.locationId, 160)
        && validTextOrEmpty(data.locationName, 180)
        && validOptionalTimestamp(data, "createdAt")
        && validTextOrEmpty(data.updatedBy, 180)
        && data.updatedAt is timestamp
        && validSoftDeleteFields(data);
    }

    // Forma setărilor locației (documentul settings/calendar_<locationId>).
    function validOptionalStringList(data, key, maxSize) {
      return !hasKey(data, key)
        || (
          data[key] is list
          && data[key].size() <= maxSize
        );
    }

    function validSettingsData(data) {
      return data.keys().hasOnly([
          "fixedSectionTitle",
          "fixedPageEnabled",
          "listPageEnabled",
          "listViewTitle",
          "resourcesSectionTitle",
          "roomsLabel",
          "groupsLabel",
          "locationId",
          "locationName",
          "updatedBy",
          "updatedAt"
        ])
        && validText(data.fixedSectionTitle, 80)
        && data.fixedPageEnabled is bool
        // Optional: settings saved before the list page could be hidden have none (= shown).
        && (!hasKey(data, "listPageEnabled") || data.listPageEnabled is bool)
        && validText(data.listViewTitle, 80)
        && validText(data.resourcesSectionTitle, 80)
        && validText(data.roomsLabel, 60)
        && validText(data.groupsLabel, 60)
        && validText(data.locationId, 160)
        && validTextOrEmpty(data.locationName, 180)
        && validTextOrEmpty(data.updatedBy, 180)
        && data.updatedAt is timestamp;
    }

    // Forma documentelor de locație și regulile de creare și de actualizare a planului de către proprietar.
    function validLocationData(data) {
      return data.keys().hasOnly([
          "name",
          "locationName",
          "address",
          "officialAddress",
          "placeId",
          "ownerEmail",
          "createdBy",
          "createdAt",
          "updatedBy",
          "updatedAt",
          "plan",
          "billingStatus",
          "subscriptionId",
          "subscriptionExpiresAt",
          "trialEndsAt",
          "usage",
          "planLimits",
          "closureRequestedAt",
          "closureRequestedBy",
          "closureScheduledFor",
          "statusBeforeClosure",
          "deleted",
          "deletedAt",
          "deletedBy",
          "deletedByUid"
        ])
        && validText(data.name, 180)
        && validOptionalText(data, "locationName", 180)
        && validOptionalText(data, "address", 300)
        && validOptionalText(data, "officialAddress", 300)
        && validOptionalText(data, "placeId", 180)
        && validOptionalText(data, "ownerEmail", 180)
        && validOptionalText(data, "createdBy", 180)
        && validOptionalTimestamp(data, "createdAt")
        && validOptionalText(data, "updatedBy", 180)
        && validOptionalTimestamp(data, "updatedAt")
        && (!hasKey(data, "plan") || validLocationPlan(data.plan))
        && (!hasKey(data, "billingStatus") || validBillingStatus(data.billingStatus))
        && validOptionalText(data, "subscriptionId", 180)
        && (!hasKey(data, "subscriptionExpiresAt") || validNullableTimestamp(data.subscriptionExpiresAt))
        && (!hasKey(data, "trialEndsAt") || validNullableTimestamp(data.trialEndsAt))
        && (!hasKey(data, "usage") || validUsageCounters(data.usage))
        && (!hasKey(data, "planLimits") || validPlanLimits(data.planLimits))
        // Set by the requestLocationClosure / cancelLocationClosure functions only;
        // listed so ordinary location writes still validate while a closure is pending.
        && validOptionalTimestamp(data, "closureRequestedAt")
        && validOptionalText(data, "closureRequestedBy", 180)
        && validOptionalTimestamp(data, "closureScheduledFor")
        && validOptionalText(data, "statusBeforeClosure", 30)
        && validSoftDeleteFields(data);
    }

    function validTrialLocationCreateData(data) {
      return hasPendingTrialSetup()
        && data.plan == "standard"
        && data.billingStatus == "trialing"
        && data.trialEndsAt is timestamp
        && data.trialEndsAt > request.time
        && (!hasKey(data, "subscriptionId") || data.subscriptionId == "")
        && (!hasKey(data, "subscriptionExpiresAt") || data.subscriptionExpiresAt == null);
    }

    function validLocationCreate() {
      return validLocationData(request.resource.data)
        && (
          isOwner()
          || (
            hasPendingLocationSetup()
            && request.resource.data.ownerEmail == request.auth.token.email
            && request.resource.data.createdBy == request.auth.token.email
            && (
              hasPendingLicense()
              || validTrialLocationCreateData(request.resource.data)
            )
          )
        );
    }

    function validOwnerLocationLicenseUpdate() {
      return signedInVerified()
        && isOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "name",
          "plan",
          "billingStatus",
          "subscriptionExpiresAt",
          "trialEndsAt",
          "updatedBy",
          "updatedAt"
        ])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(["name"])
          || validText(request.resource.data.name, 180)
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(["plan"])
          || validLocationPlan(request.resource.data.plan)
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(["billingStatus"])
          || validBillingStatus(request.resource.data.billingStatus)
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(["subscriptionExpiresAt"])
          || validNullableTimestamp(request.resource.data.subscriptionExpiresAt)
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(["trialEndsAt"])
          || validNullableTimestamp(request.resource.data.trialEndsAt)
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(["updatedBy"])
          || validTextOrEmpty(request.resource.data.updatedBy, 180)
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(["updatedAt"])
          || request.resource.data.updatedAt is timestamp
        );
    }

    // Forma licențelor și activarea/oprirea lor.
    function validLicenseData(data) {
      return data.keys().hasOnly([
          "code",
          "plan",
          "billingStatus",
          "intendedLocationName",
          "intendedAddress",
          "officialAddress",
          "placeId",
          "active",
          "claimed",
          "claimedAt",
          "claimedBy",
          "claimedByUid",
          "used",
          "usedAt",
          "usedBy",
          "usedByUid",
          "locationId",
          "locationName",
          "trialEndsAt",
          "subscriptionId",
          "subscriptionExpiresAt",
          "createdBy",
          "createdByUid",
          "createdAt",
          "updatedBy",
          "updatedAt",
          "deleted",
          "deletedAt",
          "deletedBy",
          "deletedByUid"
        ])
        && validText(data.code, 80)
        && validLocationPlan(data.plan)
        && validBillingStatus(data.billingStatus)
        && validOptionalText(data, "intendedLocationName", 180)
        && validText(data.intendedAddress, 300)
        && validOptionalText(data, "officialAddress", 300)
        && validOptionalText(data, "placeId", 180)
        && data.active is bool
        && data.claimed is bool
        && validOptionalTimestamp(data, "claimedAt")
        && validOptionalText(data, "claimedBy", 180)
        && validOptionalText(data, "claimedByUid", 160)
        && data.used is bool
        && validOptionalTimestamp(data, "usedAt")
        && validOptionalText(data, "usedBy", 180)
        && validOptionalText(data, "usedByUid", 160)
        && validOptionalText(data, "locationId", 160)
        && validOptionalText(data, "locationName", 180)
        && (!hasKey(data, "trialEndsAt") || validNullableTimestamp(data.trialEndsAt))
        && validOptionalText(data, "subscriptionId", 180)
        && (!hasKey(data, "subscriptionExpiresAt") || validNullableTimestamp(data.subscriptionExpiresAt))
        && validOptionalText(data, "createdBy", 180)
        && validOptionalText(data, "createdByUid", 160)
        && validOptionalTimestamp(data, "createdAt")
        && validOptionalText(data, "updatedBy", 180)
        && validOptionalTimestamp(data, "updatedAt")
        && validSoftDeleteFields(data);
    }

    function validLicenseActiveToggleUpdate() {
      return signedInVerified()
        && isOwner()
        && request.resource.data.active is bool
        && validOptionalText(request.resource.data, "updatedBy", 180)
        && validOptionalTimestamp(request.resource.data, "updatedAt")
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "active",
          "updatedBy",
          "updatedAt"
        ]);
    }

    // Jurnalul de audit: tipurile de entități și acțiuni și forma unei înregistrări.
    function validAuditEntityType(entityType) {
      return entityType == "booking"
        || entityType == "fixedSchedule"
        || entityType == "room"
        || entityType == "group"
        || entityType == "accessCode"
        || entityType == "user"
        || entityType == "location"
        || entityType == "license"
        || entityType == "settings";
    }

    function validAuditAction(action) {
      return action == "create"
        || action == "update"
        || action == "delete";
    }

    function validAuditSnapshot(value) {
      return value == null
        || value is map;
    }

    function validAuditLogData(data) {
      return data.keys().hasOnly([
          "locationId",
          "locationName",
          "entityType",
          "entityId",
          "action",
          "actorUid",
          "actorEmail",
          "actorName",
          "before",
          "after",
          "createdAt"
        ])
        && validText(data.locationId, 160)
        && validTextOrEmpty(data.locationName, 180)
        && validAuditEntityType(data.entityType)
        && validText(data.entityId, 180)
        && validAuditAction(data.action)
        && data.actorUid == request.auth.uid
        && data.actorEmail == request.auth.token.email
        && validText(data.actorName, 120)
        && validAuditSnapshot(data.before)
        && validAuditSnapshot(data.after)
        && data.createdAt is timestamp;
    }

    // Mesajele din pagina publică (cereri Community, contact), răspunsurile și abonarea la newsletter.
    function validCommunityApplicationStatus(status) {
      return status == "new"
        || status == "reviewed"
        || status == "replied"
        || status == "approved"
        || status == "declined";
    }

    function validCommunityApplicationSource(source) {
      return source == "landing-community"
        || source == "landing-newsletter"
        || source == "landing-contact";
    }

    function validCommunityApplicationData(data) {
      return data.keys().hasOnly([
          "email",
          "organizationName",
          "details",
          "status",
          "source",
          "createdAt"
        ])
        && validText(data.email, 180)
        && validText(data.organizationName, 180)
        && validText(data.details, 2000)
        && data.status == "new"
        && validCommunityApplicationSource(data.source)
        && data.createdAt == request.time;
    }

    function validCommunityApplicationOwnerUpdate() {
      return signedInVerified()
        && isOwner()
        && request.resource.data.keys().hasOnly([
          "email",
          "organizationName",
          "details",
          "status",
          "source",
          "createdAt",
          "reviewedAt",
          "reviewedBy",
          "reviewedByUid",
          "lastReplyAt",
          "updatedAt",
          "updatedBy",
          "updatedByUid"
        ])
        && request.resource.data.email == resource.data.email
        && request.resource.data.organizationName == resource.data.organizationName
        && request.resource.data.details == resource.data.details
        && request.resource.data.source == resource.data.source
        && request.resource.data.createdAt == resource.data.createdAt
        && validCommunityApplicationStatus(request.resource.data.status)
        && validOptionalTimestamp(request.resource.data, "reviewedAt")
        && validOptionalText(request.resource.data, "reviewedBy", 180)
        && validOptionalText(request.resource.data, "reviewedByUid", 160)
        && validOptionalTimestamp(request.resource.data, "lastReplyAt")
        && validOptionalTimestamp(request.resource.data, "updatedAt")
        && validOptionalText(request.resource.data, "updatedBy", 180)
        && validOptionalText(request.resource.data, "updatedByUid", 160)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "reviewedAt",
          "reviewedBy",
          "reviewedByUid",
          "lastReplyAt",
          "updatedAt",
          "updatedBy",
          "updatedByUid"
        ]);
    }

    function validCommunityApplicationMessageData(applicationId, data) {
      return signedInVerified()
        && isOwner()
        && data.keys().hasOnly([
          "applicationId",
          "body",
          "direction",
          "deliveryStatus",
          "fromEmail",
          "fromUid",
          "toEmail",
          "createdAt",
          "sentAt",
          "failedAt",
          "resendEmailId",
          "errorMessage"
        ])
        && data.applicationId == applicationId
        && validText(data.body, 4000)
        && data.direction == "outbound"
        && data.deliveryStatus == "pending"
        && data.fromEmail == request.auth.token.email
        && data.fromUid == request.auth.uid
        && validText(data.toEmail, 180)
        && data.createdAt == request.time
        && !hasKey(data, "sentAt")
        && !hasKey(data, "failedAt")
        && !hasKey(data, "resendEmailId")
        && !hasKey(data, "errorMessage");
    }

    function validNewsletterSubscriberPublicWrite(subscriberId, data) {
      return data.keys().hasOnly([
          "email",
          "emailKey",
          "source",
          "status",
          "unsubscribed",
          "createdAt",
          "updatedAt"
        ])
        && validText(data.email, 180)
        && validText(data.emailKey, 240)
        && data.emailKey == subscriberId
        && data.source == "landing-newsletter"
        && data.status == "active"
        && data.unsubscribed == false
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    // Campaniile newsletter și cererile de email pentru licență (create de proprietar, procesate de funcții).
    function validNewsletterCampaignCreate(data) {
      return signedInVerified()
        && isOwner()
        && data.keys().hasOnly([
          "subject",
          "body",
          "status",
          "recipientEmail",
          "createdAt",
          "createdBy",
          "createdByUid"
        ])
        && validText(data.subject, 180)
        && validText(data.body, 6000)
        && validOptionalText(data, "recipientEmail", 180)
        && data.status == "pending"
        && data.createdAt == request.time
        && data.createdBy == request.auth.token.email
        && data.createdByUid == request.auth.uid;
    }

    function validLicenseEmailRequestCreate(data) {
      return signedInVerified()
        && isOwner()
        && data.keys().hasOnly([
          "licenseId",
          "code",
          "toEmail",
          "message",
          "language",
          "status",
          "createdAt",
          "createdBy",
          "createdByUid"
        ])
        && (!hasKey(data, "language") || validLanguage(data.language))
        && validText(data.licenseId, 80)
        && validText(data.code, 80)
        && data.licenseId == data.code
        && exists(licensePath(data.licenseId))
        && get(licensePath(data.licenseId)).data.active == true
        && get(licensePath(data.licenseId)).data.claimed != true
        && get(licensePath(data.licenseId)).data.used != true
        && get(licensePath(data.licenseId)).data.deleted != true
        && validText(data.toEmail, 180)
        && validTextOrEmpty(data.message, 2000)
        && data.status == "pending"
        && data.createdAt == request.time
        && data.createdBy == request.auth.token.email
        && data.createdByUid == request.auth.uid;
    }

    // Abonamentele locațiilor.
    function validSubscriptionData(data) {
      return data.keys().hasOnly([
          "locationId",
          "locationName",
          "plan",
          "billingStatus",
          "provider",
          "providerCustomerId",
          "providerSubscriptionId",
          "currentPeriodStart",
          "currentPeriodEnd",
          "cancelAtPeriodEnd",
          "createdAt",
          "updatedAt",
          "updatedBy"
        ])
        && validText(data.locationId, 160)
        && validTextOrEmpty(data.locationName, 180)
        && validLocationPlan(data.plan)
        && validBillingStatus(data.billingStatus)
        && validOptionalText(data, "provider", 80)
        && validOptionalText(data, "providerCustomerId", 180)
        && validOptionalText(data, "providerSubscriptionId", 180)
        && (!hasKey(data, "currentPeriodStart") || validNullableTimestamp(data.currentPeriodStart))
        && (!hasKey(data, "currentPeriodEnd") || validNullableTimestamp(data.currentPeriodEnd))
        && (!hasKey(data, "cancelAtPeriodEnd") || data.cancelAtPeriodEnd is bool)
        && validOptionalTimestamp(data, "createdAt")
        && validOptionalTimestamp(data, "updatedAt")
        && validOptionalText(data, "updatedBy", 180);
    }

    // REGULILE COLECȚIILOR.
    // users/{uid}: citire de proprietar, de utilizator sau din aceeași locație; creare doar prin cod/licență/probă; actualizări prin cele patru căi de mai sus;
    // ștergere de proprietar sau de managerul locației (nu propriul cont, care se șterge prin funcția deleteMyAccount).
    match /users/{userId} {
      allow read: if signedInVerified()
        && (
          isOwner()
          || request.auth.uid == userId
          || resource.data.locationId == userLocationId()
        );

      allow create: if validUserCreate(userId);

      allow update: if signedInVerified()
        && (
          validOwnUserUpdate(userId)
          || (
            validUserDataShape(request.resource.data)
            && (
              validOwnerSyncUpdate(userId)
              || validOwnUserMetadataUpdate(userId)
              || validLocationSetupUserUpdate(userId)
              || validManagerUserUpdate(userId)
            )
          )
        );

      allow delete: if signedInVerified()
        && resource.data.isOwner != true
        && (
          isOwner()
          || (
            // Own account goes through the deleteMyAccount function (which keeps
            // the last administrator in place), never a direct client delete.
            request.auth.uid != userId
            && isLocationSuperAdmin()
            && resource.data.locationId == userLocationId()
          )
        );

      // Documentul privat cu PIN-ul este accesibil doar funcțiilor cloud (Admin SDK).
      // PIN scrypt hash + lockout state. Written/read only by the Admin SDK in the
      // setPin / verifyPin / disablePin Cloud Functions.
      match /private/{document=**} {
        allow read, write: if false;
      }
    }

    // Documentul de setări „auth_codes” nu este accesibil clienților.
    match /settings/auth_codes {
      allow read, write: if false;
    }

    // accessCodes: o căutare după id este publică (necesară înainte de autentificare, la înregistrare); lista și scrierea doar pentru proprietar și managerul locației.
    match /accessCodes/{codeId} {
      allow get: if true;
      allow list: if signedInVerified()
        && (
          isOwner()
          || (
            isLocationSuperAdmin()
            && resource.data.locationId == userLocationId()
          )
        );
      allow create: if (
          isOwner()
          || (
            isLocationSuperAdmin()
            && request.resource.data.locationId == userLocationId()
          )
        )
        && locationWriteEnabled(request.resource.data.locationId)
        && request.resource.data.code == codeId
        && validAccessRole(request.resource.data.role)
        && validAccessGroup(request.resource.data.role, request.resource.data.groupName)
        && validAccessUsage(
          request.resource.data.role,
          request.resource.data.maxUses,
          request.resource.data.usedCount,
          request.resource.data.active
        )
        && request.resource.data.keys().hasOnly([
          "code",
          "role",
          "groupName",
          "roomAccess",
          "allowedRoomIds",
          "locationId",
          "locationName",
          "maxUses",
          "usedCount",
          "active",
          "createdBy",
          "createdAt",
          "deleted",
          "expiresAt"
        ])
        && validText(request.resource.data.locationName, 180)
        && validRoomAccessData(request.resource.data.role, request.resource.data)
        && validTextOrEmpty(request.resource.data.createdBy, 180)
        && request.resource.data.createdAt is timestamp
        // Optional: codes created before this field existed have none and stay
        // non-expiring (grandfathered) - see accessCodeNotExpired().
        && (!("expiresAt" in request.resource.data) || request.resource.data.expiresAt is timestamp)
        && validSoftDeleteFields(request.resource.data);
      allow update: if validAccessCodeSoftDeleteUpdate()
        || validAccessCodeManagerUpdate()
        || validAccessUseUpdate(codeId);
      allow delete: if (
          isOwner()
          || (
            isLocationSuperAdmin()
            && resource.data.locationId == userLocationId()
          )
        )
        && locationWriteEnabled(resource.data.locationId);
    }

    // settings/calendar_<locationId>: citire pentru membrii locației, scriere pentru proprietar și managerul locației.
    match /settings/{settingId} {
      // Match on the doc id (settings/calendar_<locationId>) rather than
      // resource.data so a not-yet-created settings doc resolves cleanly instead
      // of throwing a null-deref evaluation error on every member's first load.
      allow read: if signedInVerified()
        && settingId != "auth_codes"
        && (
          isOwner()
          || settingId == "calendar_" + userLocationId()
        );
      allow create, update: if settingId != "auth_codes"
        && (
          isOwner()
          || isLocationSuperAdmin()
        )
        && validSettingsData(request.resource.data)
        && (
          isOwner()
          || request.resource.data.locationId == userLocationId()
        )
        && locationWriteEnabled(request.resource.data.locationId);
      allow delete: if settingId != "auth_codes"
        && (
          isOwner()
          || (
            isLocationSuperAdmin()
            && resource.data.locationId == userLocationId()
          )
        );
    }

    // licenses: o licență disponibilă poate fi citită după id înainte de autentificare; lista, crearea și ștergerea sunt ale proprietarului;
    // un cont nou o poate revendica și apoi marca ca folosită, schimbând doar câmpurile permise.
    match /licenses/{licenseId} {
      allow get: if (
          signedInVerified()
          && (
            isOwner()
            || hasPendingLicense()
            || resource.data.claimedByUid == request.auth.uid
          )
        )
        || (
          !signedIn()
          && resource.data.active == true
          && resource.data.used != true
          && resource.data.claimed != true
          && resource.data.deleted != true
        );
      allow list: if signedInVerified() && isOwner();
      allow create: if signedInVerified()
        && isOwner()
        && request.resource.data.code == licenseId
        && validLicenseData(request.resource.data);
      allow delete: if signedInVerified() && isOwner();
      allow update: if validLicenseActiveToggleUpdate()
        || (
          signedInVerified()
          && isOwner()
          && validLicenseData(request.resource.data)
        )
        || (
          signedIn()
          && (
            !hasUserDoc()
            || (
              hasPendingLicense()
              && userData().pendingLicenseId == licenseId
            )
          )
          && resource.data.used != true
          && resource.data.claimed != true
          && resource.data.active != false
          && resource.data.deleted != true
          && request.resource.data.claimed == true
          && request.resource.data.claimedByUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "claimed",
            "claimedAt",
            "claimedBy",
            "claimedByUid"
          ])
        )
        || (
          signedInVerified()
          && resource.data.claimedByUid == request.auth.uid
          && resource.data.used != true
          && resource.data.active != false
          && resource.data.deleted != true
          && request.resource.data.used == true
          && request.resource.data.usedByUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "used",
            "usedAt",
            "usedBy",
            "usedByUid",
            "locationId",
            "locationName",
            "intendedAddress",
            "officialAddress"
          ])
        );
    }

    // communityApplications și mesajele lor: oricine poate trimite o cerere; citirea, răspunsul și ștergerea sunt ale proprietarului.
    match /communityApplications/{applicationId} {
      allow create: if validCommunityApplicationData(request.resource.data);
      allow read: if signedInVerified() && isOwner();
      allow update: if validCommunityApplicationOwnerUpdate();
      allow delete: if signedInVerified() && isOwner();

      match /messages/{messageId} {
        allow read: if signedInVerified() && isOwner();
        allow create: if validCommunityApplicationMessageData(applicationId, request.resource.data);
        allow update: if false;
        allow delete: if signedInVerified() && isOwner();
      }
    }

    // newsletterSubscribers: abonarea e publică (cu format validat); lista și ștergerea sunt ale proprietarului.
    match /newsletterSubscribers/{subscriberId} {
      allow create, update: if validNewsletterSubscriberPublicWrite(subscriberId, request.resource.data)
        || (signedInVerified() && isOwner());
      allow read, delete: if signedInVerified() && isOwner();
    }

    // errorReports: un utilizator autentificat poate trimite un raport cu propriul uid; doar proprietarul îl citește și îl marchează rezolvat.
    match /errorReports/{reportId} {
      allow create: if signedInVerified()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == "new"
        && request.resource.data.userMessage is string
        && request.resource.data.userMessage.size() <= 4000
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 6000
        && request.resource.data.keys().hasOnly([
          "message", "componentStack", "userMessage", "path", "userAgent",
          "appVersion", "uid", "email", "status", "createdAt",
          "resolvedAt", "resolvedBy"
        ]);
      allow read: if signedInVerified() && isOwner();
      allow update: if signedInVerified() && isOwner()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["status", "resolvedAt", "resolvedBy"]);
      allow delete: if signedInVerified() && isOwner();
    }

    // newsletterCampaigns și licenseEmailRequests: create de proprietar; trimiterea o fac funcțiile cloud, care actualizează starea.
    match /newsletterCampaigns/{campaignId} {
      allow read: if signedInVerified() && isOwner();
      allow create: if validNewsletterCampaignCreate(request.resource.data);
      allow update: if false;
      allow delete: if signedInVerified() && isOwner();

      match /deliveries/{deliveryId} {
        allow read: if signedInVerified() && isOwner();
        allow write: if false;
      }
    }

    match /licenseEmailRequests/{requestId} {
      allow read: if signedInVerified() && isOwner();
      allow create: if validLicenseEmailRequestCreate(request.resource.data);
      allow update: if false;
      allow delete: if signedInVerified() && isOwner();
    }

    // subscriptions: citite de proprietar și de managerul locației; scrise doar de proprietar.
    match /subscriptions/{subscriptionId} {
      allow read: if signedInVerified()
        && (
          isOwner()
          || (
            resource.data.locationId == userLocationId()
            && isLocationSuperAdmin()
          )
        );
      allow create, update: if signedInVerified()
        && isOwner()
        && validSubscriptionData(request.resource.data);
      allow delete: if signedInVerified() && isOwner();
    }

    // events (rezervările): citire pentru membrii locației; creare și modificare cu validare și verificarea grupului, camerei și stării licenței;
    // ștergere logică și ștergere pentru proprietar, managerul locației sau autorul (administrator). Clientul scrie în principal prin funcția saveBooking.
    match /events/{eventId} {
      allow read: if signedInVerified()
        && (
          isOwner()
          || resource.data.locationId == userLocationId()
        );
      allow create: if signedInVerified()
        && validEventData(request.resource.data)
        && (
          isOwner()
          || request.resource.data.locationId == userLocationId()
        )
        && bookingGroupAllowed(request.resource.data)
        && roomAccessAllows(request.resource.data.roomId)
        && locationWriteEnabled(request.resource.data.locationId);
      // Cheap path: soft-delete marker only. The client deletes a booking with a
      // partial updateDoc({deleted:true, deletedAt, deletedBy, deletedByUid,
      // updatedBy, updatedAt}); running the full validEventData() + all the get()s
      // on that path blows Firestore's 1000-expression budget, so authorize it
      // directly instead.
      allow update: if (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["deleted", "deletedAt", "deletedBy", "deletedByUid", "updatedBy", "updatedAt"])
          && request.resource.data.deleted == true
          && request.resource.data.updatedAt is timestamp
          && request.resource.data.updatedBy is string
          && (
            (isOwner() || canManageLocation(resource.data.locationId))
            || (
              isLocationAdmin()
              && resource.data.locationId == userLocationId()
              && (
                resource.data.authorEmail == request.auth.token.email
                || resource.data.author == request.auth.token.email
              )
            )
          )
        )
        || (
          validEventData(request.resource.data)
          && locationWriteEnabled(resource.data.locationId)
          && roomAccessAllows(request.resource.data.roomId)
          && bookingGroupAllowed(request.resource.data)
          && (
            (
              (isOwner() || canManageLocation(resource.data.locationId))
              && request.resource.data.locationId == resource.data.locationId
            )
            || (
              isLocationAdmin()
              && resource.data.locationId == userLocationId()
              && request.resource.data.locationId == resource.data.locationId
              && (
                resource.data.authorEmail == request.auth.token.email
                || resource.data.author == request.auth.token.email
              )
            )
          )
        );
      allow delete: if ((isOwner() || canManageLocation(resource.data.locationId)) && locationWriteEnabled(resource.data.locationId))
        || (
          isLocationAdmin()
          && resource.data.locationId == userLocationId()
          && locationWriteEnabled(resource.data.locationId)
          && (
            resource.data.authorEmail == request.auth.token.email
            || resource.data.author == request.auth.token.email
          )
        );
    }

    // rooms, groups și fixedSchedules: citire pentru membrii locației; creare, modificare și ștergere doar pentru managerul locației (proprietarul nu scrie aici), cu licență activă.
    match /rooms/{roomId} {
      allow read: if signedInVerified()
        && (
          isOwner()
          || resource.data.locationId == userLocationId()
        );
      allow create: if canManageLocation(request.resource.data.locationId)
        && locationWriteEnabled(request.resource.data.locationId)
        && validSpaceData(request.resource.data);
      allow update: if canManageLocation(resource.data.locationId)
        && locationWriteEnabled(resource.data.locationId)
        && request.resource.data.locationId == resource.data.locationId
        && validSpaceData(request.resource.data);
      allow delete: if canManageLocation(resource.data.locationId)
        && locationWriteEnabled(resource.data.locationId);
    }

    match /groups/{groupId} {
      allow read: if signedInVerified()
        && (
          isOwner()
          || resource.data.locationId == userLocationId()
        );
      allow create: if canManageLocation(request.resource.data.locationId)
        && locationWriteEnabled(request.resource.data.locationId)
        && validSpaceData(request.resource.data);
      allow update: if canManageLocation(resource.data.locationId)
        && locationWriteEnabled(resource.data.locationId)
        && request.resource.data.locationId == resource.data.locationId
        && validSpaceData(request.resource.data);
      allow delete: if canManageLocation(resource.data.locationId)
        && locationWriteEnabled(resource.data.locationId);
    }

    match /fixedSchedules/{scheduleId} {
      allow read: if signedInVerified()
        && (
          isOwner()
          || resource.data.locationId == userLocationId()
        );
      allow create: if canManageLocation(request.resource.data.locationId)
        && locationWriteEnabled(request.resource.data.locationId)
        && validFixedScheduleData(request.resource.data);
      allow update: if canManageLocation(resource.data.locationId)
        && locationWriteEnabled(resource.data.locationId)
        && request.resource.data.locationId == resource.data.locationId
        && validFixedScheduleData(request.resource.data);
      allow delete: if canManageLocation(resource.data.locationId)
        && locationWriteEnabled(resource.data.locationId);
    }

    // auditLogs: citire pentru proprietar și manageri; creare cu autorul propriu; nu se modifică și nu se șterg din client.
    match /auditLogs/{logId} {
      allow read: if signedInVerified()
        && (
          isOwner()
          || (
            isLocationSuperAdmin()
            && resource.data.locationId == userLocationId()
          )
        );
      allow create: if signedInVerified()
        && validAuditLogData(request.resource.data)
        && (
          isOwner()
          || request.resource.data.locationId == userLocationId()
        );
      allow update, delete: if false;
    }

    // Billing record of a purged location, written only by the purge function
    // (Admin SDK) so licence/subscription history still points at something.
    // closedLocations: arhiva datelor de facturare ale unei locații șterse; citită de proprietar, scrisă doar de funcția cloud.
    match /closedLocations/{locationId} {
      allow read: if signedInVerified() && isOwner();
      allow write: if false;
    }

    // locations: citire pentru membrii locației (cu excepția de bootstrap de mai jos); creare și actualizare cu validare; planul și facturarea doar de proprietar;
    // ștergerea directă doar de proprietar (managerii închid locația prin funcția requestLocationClosure).
    match /locations/{locationId} {
      // The !hasUserDoc() branch is a deliberate bootstrap exception: a brand-new
      // access-code registration creates the Auth user, then reads the location
      // (to confirm it still exists / get its live name) BEFORE the users/{uid}
      // profile doc is written and BEFORE the verification email is even sent —
      // so signedInVerified() can never be true yet. Gating this whole allow on
      // signedInVerified() silently broke every non-owner access-code signup
      // ("Missing or insufficient permissions" on account creation). Only the
      // no-user-doc bootstrap case skips verification; every other branch below
      // still requires it.
      allow get: if (
          signedInVerified()
          && (
            isOwner()
            || locationId == userLocationId()
            || hasPendingLocationSetup()
          )
        )
        || (signedIn() && !hasUserDoc());
      allow list: if signedInVerified() && isOwner();
      allow create: if signedInVerified()
        && validLocationCreate();
      allow update: if validOwnerLocationLicenseUpdate()
        || (
          isOwner()
          && validLocationData(request.resource.data)
        )
        || (
          // A location manager may edit descriptive fields and bump usage
          // counters, but NOT plan / billingStatus / subscription* / trialEndsAt /
          // ownerEmail / planLimits — those are owner-only (privilege boundary).
          canManageLocation(locationId)
          && locationWriteEnabled(locationId)
          && validLocationData(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "name",
            "locationName",
            "address",
            "officialAddress",
            "placeId",
            "updatedBy",
            "updatedAt",
            "usage"
          ])
        );
      // Closing a location goes through requestLocationClosure (30 days read-only,
      // then a scheduled purge removes its data and accounts) - a client delete would
      // leave all of that orphaned, so only the platform owner may delete directly.
      allow delete: if isOwner();
    }
  }
}
